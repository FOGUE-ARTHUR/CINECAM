# .env.example - Template de variables d'environnement

# Application
VITE_APP_NAME=CINECAM

# URL publique du site (utilisée pour sitemap.xml en production)
# SITE_URL=https://cinecam.example.com

# E-mail optionnel pour promouvoir automatiquement le premier compte admin créé
# (aucun mot de passe par défaut n'est stocké dans le code)
# VITE_ADMIN_EMAIL=admin@cinecam.com

# Base locale
VITE_DB_TYPE=sqlite
